{
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	// tests/vectors is vendored byte for byte from sdk-conformance: CI diffs it against the source.
	"ignorePatterns": [".claude/settings.local.json", "CHANGELOG.md", "tests/vectors/**"],
}
