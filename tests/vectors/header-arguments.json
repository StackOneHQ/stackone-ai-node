{
    "$schema": "./schema/header-arguments.schema.json",
    "description": "Invariant 4 as data: a tool's served inputSchema, the model's arguments, the arguments that reach tools/call, and the warnings the SDK emits, in argument order. A warning is {argument, header?, reason}: `argument` is the top-level key (`headers` or `headers_<name>`); `header` is the trimmed nested name, for an entry of a `headers` object. `reason` is one of `reasons`; messages.json renders it.",
    "version": 1,
    "reasons": ["set-by-sdk", "not-declared", "malformed", "not-an-object", "not-a-scalar"],
    "cases": [
        {
            "id": "open-forwards-every-name",
            "description": "an open headers object (type object, no properties, additionalProperties not false) declares every name",
            "schema": {
                "type": "object",
                "properties": {
                    "headers": {
                        "type": "object"
                    }
                }
            },
            "arguments": {
                "headers": {
                    "x-custom": "a",
                    "X-Other": "b"
                }
            },
            "expected_arguments": {
                "headers": {
                    "x-custom": "a",
                    "X-Other": "b"
                }
            },
            "expected_warnings": []
        },
        {
            "id": "open-drops-sdk-owned",
            "description": "an open object still never forwards an SDK-owned name",
            "schema": {
                "type": "object",
                "properties": {
                    "headers": {
                        "type": "object"
                    }
                }
            },
            "arguments": {
                "headers": {
                    "Authorization": "Bearer x",
                    "x-account-id": "victim",
                    "User-Agent": "evil/0",
                    "x-custom": "a"
                }
            },
            "expected_arguments": {
                "headers": {
                    "x-custom": "a"
                }
            },
            "expected_warnings": [
                {
                    "argument": "headers",
                    "header": "Authorization",
                    "reason": "set-by-sdk"
                },
                {
                    "argument": "headers",
                    "header": "x-account-id",
                    "reason": "set-by-sdk"
                },
                {
                    "argument": "headers",
                    "header": "User-Agent",
                    "reason": "set-by-sdk"
                }
            ]
        },
        {
            "id": "open-additional-properties-true",
            "description": "additionalProperties: true is open",
            "schema": {
                "type": "object",
                "properties": {
                    "headers": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            },
            "arguments": {
                "headers": {
                    "x-custom": "a"
                }
            },
            "expected_arguments": {
                "headers": {
                    "x-custom": "a"
                }
            },
            "expected_warnings": []
        },
        {
            "id": "open-additional-properties-schema",
            "description": "additionalProperties as a schema is open",
            "schema": {
                "type": "object",
                "properties": {
                    "headers": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                }
            },
            "arguments": {
                "headers": {
                    "x-custom": "a"
                }
            },
            "expected_arguments": {
                "headers": {
                    "x-custom": "a"
                }
            },
            "expected_warnings": []
        },
        {
            "id": "closed-declares-nothing",
            "description": "a closed object (additionalProperties: false, no properties) declares no names; headers is sent empty",
            "schema": {
                "type": "object",
                "properties": {
                    "headers": {
                        "type": "object",
                        "additionalProperties": false
                    }
                }
            },
            "arguments": {
                "headers": {
                    "x-custom": "a"
                }
            },
            "expected_arguments": {
                "headers": {}
            },
            "expected_warnings": [
                {
                    "argument": "headers",
                    "header": "x-custom",
                    "reason": "not-declared"
                }
            ]
        },
        {
            "id": "closed-with-properties",
            "description": "a closed object with properties declares exactly those",
            "schema": {
                "type": "object",
                "properties": {
                    "headers": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "x-custom": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "arguments": {
                "headers": {
                    "x-custom": "a",
                    "x-other": "b"
                }
            },
            "expected_arguments": {
                "headers": {
                    "x-custom": "a"
                }
            },
            "expected_warnings": [
                {
                    "argument": "headers",
                    "header": "x-other",
                    "reason": "not-declared"
                }
            ]
        },
        {
            "id": "declared-nested",
            "description": "declared names are forwarded; an undeclared one is not; a declared SDK-owned one is not; a non-header argument is untouched",
            "schema": {
                "type": "object",
                "properties": {
                    "path": {
                        "type": "object"
                    },
                    "headers": {
                        "type": "object",
                        "properties": {
                            "x-custom": {
                                "type": "string"
                            },
                            "Authorization": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "arguments": {
                "path": {
                    "id": "emp_1"
                },
                "headers": {
                    "x-custom": "a",
                    "x-other": "b",
                    "authorization": "Bearer x"
                }
            },
            "expected_arguments": {
                "path": {
                    "id": "emp_1"
                },
                "headers": {
                    "x-custom": "a"
                }
            },
            "expected_warnings": [
                {
                    "argument": "headers",
                    "header": "x-other",
                    "reason": "not-declared"
                },
                {
                    "argument": "headers",
                    "header": "authorization",
                    "reason": "set-by-sdk"
                }
            ]
        },
