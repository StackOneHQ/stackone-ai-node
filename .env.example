# Required for all examples
STACKONE_API_KEY=your-stackone-api-key

# Optional: the examples read this and pass it as accountId (the SDK itself never reads it).
# Without it, the SDK uses every active account linked to the API key
STACKONE_ACCOUNT_ID=your-account-id

# Required for OpenAI examples (openai-integration, openai-responses-integration, ai-sdk-integration)
OPENAI_API_KEY=your-openai-api-key

# Required for Anthropic examples (anthropic-integration, claude-agent-sdk-integration)
ANTHROPIC_API_KEY=your-anthropic-api-key
